{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "Vigour UI Review",
  "version": "0.0.1",
  "description": "采集 Web 实现图、DOM 和计算样式并发送至本地 Vigour UI Review 工作台。",
  "permissions": ["activeTab", "scripting", "storage", "nativeMessaging", "alarms"],
  "host_permissions": ["http://127.0.0.1:4179/*"],
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Vigour UI Review", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" } },
  "background": { "service_worker": "service-worker.js", "type": "module" }
}
